// Cloudflare Workers config for the OpenNext build. Worker "shop" lives at
// https://shop.livrelb.workers.dev (the address is NEXT_PUBLIC_SITE_URL, see
// src/config/site.ts).
// Before the first deploy (see README "Hosting on Cloudflare"):
//   npx wrangler r2 bucket create livrelb-opennext-cache
//   (done) D1 livrelb-tag-cache created; R2 buckets need R2 enabled in the dashboard
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference, required by the OpenNext cache. Must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "shop"
    }
  ],
  // Rendered pages (ISR cache).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "livrelb-opennext-cache"
    }
  ],
  // revalidateTag("catalog") timestamps, so admin edits show up at once.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "livrelb-tag-cache",
      "database_id": "acb58e34-f773-48aa-a30e-1ac36ecd0ff4"
    }
  ],
  // Background page revalidation queue.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  // next/image resizing through Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
