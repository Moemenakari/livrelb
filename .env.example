# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Values: Supabase dashboard → Project Settings → API Keys.
# Create the project in the Frankfurt region (eu-central-1), closest to Lebanon.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose in the browser:
# Row Level Security protects the data. The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
