# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase project: livrelb, Frankfurt (eu-central-1).

# Project URL (Project Settings → Data API), e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, starts with sb_publishable_ (Project Settings → API Keys).
# Safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, starts with sb_secret_ (Project Settings → API Keys).
# SERVER ONLY: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Signs the "remembered device" cookie of returning customers (checkout
# prefill, LIVRE Points). SERVER ONLY. Any long random string, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Falls back to SUPABASE_SECRET_KEY when empty. Changing it forgets every device.
CUSTOMER_COOKIE_SECRET=

# Phone notifications for the staff (Web Push): new orders, reviews, team
# changes. SERVER ONLY. Make a pair with: node scripts/vapid-keys.mjs
# Empty = the admin's "Notify me" button stays hidden. Changing them means
# everyone presses "Notify me" again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Postgres connection string, for migrations, seeding and backups (never
# used by the website). Use the "Session pooler" string from Connect →
# Connection string: it works over IPv4 (the direct one is IPv6 only on the
# free plan). Put your database password in place of [YOUR-PASSWORD].
SUPABASE_DB_URL=

# Cloudflare R2: product photos (admin uploads). Needed from the admin phase.
# R2 → Manage API tokens → "Object Read & Write" on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=livrelb-media
# Public address of the bucket (custom domain or r2.dev URL), no trailing slash.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Phase 5 (all optional: each feature stays hidden until its keys exist) ---

# AI thank-you message in the admin (points approval). Without it the admin
# gets a fixed message template. SERVER ONLY. console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# Visa / Mastercard (the bank's Mastercard Payment Gateway, "Hosted Checkout").
# Your bank gives you these when the merchant account opens. SERVER ONLY.
# URL looks like https://<bank>.gateway.mastercard.com (no trailing slash).
CARD_GATEWAY_URL=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_API_PASSWORD=
# Then switch "Visa / Mastercard online" on in the admin Settings.

# Whish online payment (when Whish gives the merchant account).
WHISH_API_URL=
WHISH_MERCHANT_ID=
WHISH_API_KEY=

# Meta Conversions API (server-side Pixel events). The Pixel ID itself is
# typed in the admin Settings. Events.Manager -> Settings -> Conversions API
# -> Generate access token. META_CAPI_TEST_CODE is only for testing.
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=

# Public address of the site, no trailing slash (canonical links, sitemap, share
# pictures). Build variable. Default: https://shop.livrelb.workers.dev
NEXT_PUBLIC_SITE_URL=https://shop.livrelb.workers.dev

# Phone verification by WhatsApp (Meta WhatsApp Cloud API, about $0.011 a code in
# Lebanon, no monthly fee). Hidden until all three exist. SERVER ONLY.
#   1. developers.facebook.com -> create an app (Business) -> add "WhatsApp".
#   2. WhatsApp Manager: add the sending number, create an AUTHENTICATION template
#      named livre_verification_code, in English (en) and in Arabic (ar).
#   3. Business settings -> System users -> a permanent token with whatsapp_business_messaging.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=livre_verification_code
