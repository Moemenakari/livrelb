# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase project: livrelb, Frankfurt (eu-central-1).

# Project URL (Project Settings → Data API), e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key, starts with sb_publishable_ (Project Settings → API Keys).
# Safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key, starts with sb_secret_ (Project Settings → API Keys).
# SERVER ONLY: bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Postgres connection string, for migrations, seeding and backups (never
# used by the website). Use the "Session pooler" string from Connect →
# Connection string: it works over IPv4 (the direct one is IPv6 only on the
# free plan). Put your database password in place of [YOUR-PASSWORD].
SUPABASE_DB_URL=

# Cloudflare R2: product photos (admin uploads). Needed from the admin phase.
# R2 → Manage API tokens → "Object Read & Write" on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=livrelb-images
# Public address of the bucket (custom domain or r2.dev URL), no trailing slash.
NEXT_PUBLIC_R2_PUBLIC_URL=
